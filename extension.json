{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "turnstile",
    "name": "Cloudflare Turnstile",
    "version": "1.0.0",
    "description": "Replaces reCAPTCHA with Cloudflare Turnstile on the login, forgot password and password reset pages.",
    "author": "Olivier DUTOIT",
    "icon": "shield-check",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.5 <3.0",
        "php": "^8.3"
    },
    "provider": "OlivierDutoit\\Turnstile\\TurnstileProvider",
    "autoload": {
        "OlivierDutoit\\Turnstile\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "ts"
    }
}
